{
  "name": "@tint/identity-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --dts --out-dir dist",
    "start": "node dist/server.js",
    "lint": "echo 'skip lint for now'",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "asap": "^2.0.6",
    "cors": "2.8.5",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "jwks-rsa": "3.1.0",
    "nanoid": "^5.1.16",
    "pg": "8.13.1",
    "uuid": "11.0.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/http-errors": "^2.0.5",
    "@types/jsonwebtoken": "9.0.7",
    "@types/mime": "^3.0.4",
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "@types/qs": "^6.15.1",
    "@types/range-parser": "^1.2.7",
    "@types/send": "^1.2.1",
    "@types/serve-static": "^2.2.0",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.31.11",
    "supertest": "7.0.0",
    "ts-node-dev": "2.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  },
  "allowScripts": {
    "esbuild": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true,
    "protobufjs": true
  }
}
