POSTGRES_USER=tint
POSTGRES_PASSWORD=tint
POSTGRES_DB=tint
MINIO_ROOT_USER=tintadmin
MINIO_ROOT_PASSWORD=tintadmin123
MINIO_BUCKET=tint-media
# Secreto HS256 compartido: identity-api emite los tokens; sync-core, social-core y analytics los validan.
JWT_SECRET=dev-secret-change-in-prod
JWT_ISSUER=tint-identity
JWT_AUDIENCE=tint:room
SYNC_ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173
SOCIAL_ALLOWED_ORIGINS=localhost:5173,127.0.0.1:5173
# API de solo lectura de analytics (KPIs del host). Orígenes con esquema, separados por comas.
ANALYTICS_PORT=8084
ANALYTICS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# identity-api y web en compose. FIREBASE_PROJECT_ID lo validan identity-api y social-core.
FIREBASE_PROJECT_ID=tint-login
# Host de MinIO que ve el navegador en las URLs firmadas (el interno es minio:9000).
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# La web incrusta estas variables al compilar (build args): son las URLs que ve el navegador.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=tint-login
